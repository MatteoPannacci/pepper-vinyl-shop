topic: ~assistant()
language: enu

# --- Concepts ---

concept: (myname) ["My name is" "I'm" "I am"
                   "This is" "They call me" "You can call me" 
                   "I go by" "The name's" "It's me"]

concept: (greetings) ^rand["hi" "hello" "hello there" "hey there" "good morning"
                           "hey" "hi there" "good afternoon" "good evening"
                           "greetings" "good day"]

concept: (goodbye) ["goodbye"]

concept: (acceptance) ["yes" "ok"]

concept: (refusal) ["no"]

concept: (dont_know) ["I don't know"]

concept: (rating) ["1" "2" "3" "4" "5"]



# --- Global Greeting ---
u: ([
        ~greetings
        "e:pepper-vinyl/answer $pepper-vinyl/answer==start_button"
    ])
    ^gotoReactivate(begin)



# --- Restart ---
proposal: %restart
    $pepper-vinyl/tablet=ask_welcome

    u1: ([
            ~greetings
            "e:pepper-vinyl/answer $pepper-vinyl/answer==start_button"
        ]) 
        ^gotoReactivate(begin)



# --- Begin ---
proposal: %begin
    $pepper-vinyl/tablet=execute_hello
    Hello! I'm Pepper, your shopping assistant for this Vinyl Shop.
    I'm here to inform and help you.
    ^gotoReactivate(name)



# --- Global Goodbye ---
u: (~goodbye) 
    Goodbye! I'm going to wait for the next client.
    ^gotoReactivate(restart)



# --- Asking Name ---
proposal: %name
    What's your name?
    $pepper-vinyl/tablet_dyn=name_from_keyboard

    u1: ({~myname} _*)
        $pepper-vinyl/username=$1
        ^gotoReactivate(check_name)

    u1: (e:pepper-vinyl/tablet_finish)
        $pepper-vinyl/username = $pepper-vinyl/answer
        ^gotoReactivate(check_name)


# -- Checking Name ---
proposal: %check_name
    $pepper-vinyl/function=check_username

    u1: ("e:pepper-vinyl/recognized $pepper-vinyl/recognized==true")
        $pepper-vinyl/tablet_dyn=welcome_old_user
        ~greetings $pepper-vinyl/username ! Welcome back to our shop!
        ^gotoReactivate(specific)
    
    u1: ("e:pepper-vinyl/recognized $pepper-vinyl/recognized==false") 
        $pepper-vinyl/tablet_dyn=welcome_new_user
        ~greetings $pepper-vinyl/username ! Nice to meet you!
        ^gotoReactivate(specific)




# --- Asking for specific Vinyl ---
proposal: %specific
    $pepper-vinyl/tablet=ask_specific
    Anything specific you are looking for?

    u1: ([
            ~acceptance
            "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
        ])
        $pepper-vinyl/tablet=execute_empty-show
        Tell me the name and i will look for it or you can search on the tablet.
        $pepper-vinyl/tablet_dyn=show_vinyls

        u2: (_*)
            $pepper-vinyl/vinyl_name=$1
            ^gotoReactivate(check_storage)

        u2: (e:pepper-vinyl/tablet_finish)
            $pepper-vinyl/vinyl_name = $pepper-vinyl/answer
            ^gotoReactivate(check_storage)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
        ])
        Ok, i can suggest you something if you want.

        u2: (~acceptance)
            $pepper-vinyl/function="check_favourite"

            u3: (e:pepper-vinyl/has_favourite $pepper-vinyl/has_favourite==true)
                ^gotoReactivate(give_suggestion)
            
            u3: (e:pepper-vinyl/has_favourite $pepper-vinyl/has_favourite==false)
                But before i need to know what you like.
                ^gotoReactivate(ask_favourite)

        u2: (~refusal)
            ^gotoReactivate(need_something_else)



proposal: %check_storage
    $pepper-vinyl/tablet=execute_check-storage
    I will look in our storage database for $pepper-vinyl/vinyl_name .
    $pepper-vinyl/function="check_storage"
    
    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==available)
        $pepper-vinyl/tablet=execute_vinyl-found
        I found the vinyl you were looking for.
        ^gotoReactivate(get_the_vinyl)
    
    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==out_of_stock)
        $pepper-vinyl/tablet_dyn=order_vinyl
        We don't have it in storage right now but i can order it for you.
        Do you want me to procede?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            Ok, i will add it to the list of orders.
            $pepper-vinyl/function="order_vinyl"
            ^gotoReactivate(need_something_else)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            ^gotoReactivate(need_something_else)

    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==unknown)
        $pepper-vinyl/tablet=execute_vinyl-not-found
        I'm sorry, i don't know any vinyl with that name.
        ^gotoReactivate(need_something_else)



proposal: %get_the_vinyl
    $pepper-vinyl/function="point_to_vinyl"

    u1: (e:pepper-vinyl/finish_wait)
        $pepper-vinyl/tablet=ask_get-the-vinyl
        It is right there.
        Do you want me to guide you to it?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            $pepper-vinyl/tablet=execute_follow-me
            Ok, follow me then.
            $pepper-vinyl/function=guide_client

            u3: (e:pepper-vinyl/finish_wait)
                $pepper-vinyl/tablet=execute_here-it-is
                Your vinyl is right here.
                ^gotoReactivate(need_something_else)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            $pepper-vinyl/tablet=execute_wait-here
            Ok, I'll take it and bring it back to you.
            $pepper-vinyl/function="take_and_go_back"

            u3: (e:pepper-vinyl/finish_wait)
                $pepper-vinyl/tablet=execute_here-it-is
                Here is your vinyl.
                ^gotoReactivate(need_something_else)



proposal: %ask_favourite
    What is you favourite genre? 

    u1: (~dont_know)
        $pepper-vinyl/favourite_genre="anything"
        $pepper-vinyl/function="set_favourite"
        ^gotoReactivate(give_suggestion)

    u1: (_*)
        $pepper-vinyl/favourite_genre=$1
        $pepper-vinyl/function="set_favourite"

        u2: (e:pepper-vinyl/genre_recognized $pepper-vinyl/genre_recognized==true)
            ^gotoReactivate(give_suggestion)

        u2: (e:pepper-vinyl/genre_recognized $pepper-vinyl/genre_recognized==false)
            That doesn't look like a music genre, could you try something else?
            ^gotoReactivate(ask_favourite)



proposal: %give_suggestion
    $pepper-vinyl/function="find_suggestion"

    u1: (e:pepper-vinyl/suggestion)
        Here is the newest vinyl from $pepper-vinyl/selected_genre:  "$pepper-vinyl/suggestion" .
        Do you want to listen to a demo of it?

        u2: (~acceptance)
            Ok, i will play a demo from $pepper-vinyl/suggestion .
            $pepper-vinyl/function="play_demo"

            u3: (e:pepper-vinyl/finish_wait)
                That was the demo. Are you interested in buying the vinyl?

                u4: (~acceptance)
                    $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
                    ^gotoReactivate(get_the_vinyl)

                u4: (~refusal)
                    ^gotoReactivate(need_something_else)

        u2: (~refusal)
            Do you want to buy it?

            u3: (~acceptance)
                $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
                ^gotoReactivate(get_the_vinyl)

            u3: (~refusal)
                ^gotoReactivate(need_something_else)



proposal: %need_something_else
    $pepper-vinyl/tablet=ask_need-something-else
    Do you need help with something else?

    u1: ([
            ~acceptance
            "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
        ])
        ^gotoReactivate(specific)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
        ])
        $pepper-vinyl/tablet=execute_goodbye
        Thank you for choosing our store, you can find the cashier near the entrance.
        If you need something else you can ask me again.
        $pepper-vinyl/function=reset

        u2: (e:pepper-vinyl/finish_wait)
            ^gotoReactivate(restart)