topic: ~assistant()
language: enu

# --- Concepts ---

concept: (myname) ["My name is" "I'm" "I am"
                   "This is" "They call me" "You can call me" 
                   "I go by" "The name's" "It's me"]

concept: (myname_after) ["is my name"]

concept: (greetings) ^rand["hi" "hello" "hello there" "hey there" "good morning"
                           "hey" "hi there" "good afternoon" "good evening"
                           "greetings" "good day"]

concept: (goodbye) ["goodbye"]

concept: (acceptance) ["yes" "ok" "fine" "right"]

concept: (refusal) ["no" "nope"]

concept: (dont_know) ["I don't know" "don't know"]

concept: (rating) ["1" "2" "3" "4" "5"]



# --- Global Greeting ---
u: ([
        ~greetings
        "e:pepper-vinyl/answer $pepper-vinyl/answer==start_button"
        e:pepper-vinyl/user_passing
    ])
    ^gotoReactivate(begin)



# --- Restart ---
proposal: %restart
    $pepper-vinyl/tablet=ask_welcome

    u1: ([
            ~greetings
            "e:pepper-vinyl/answer $pepper-vinyl/answer==start_button"
        ]) 
        ^gotoReactivate(begin)



# --- Begin ---
proposal: %begin
    $pepper-vinyl/tablet=execute_hello
    ^start(animations/Stand/Gestures/Hey_1)
    Hello! I'm Pepper, your shopping assistant for this Vinyl Shop.
    I'm here to inform and help you.
    ^gotoReactivate(name)



# --- Global Goodbye ---
u: (~goodbye)
    Goodbye! I'm going to wait for the next client.
    ^gotoReactivate(restart)



# --- Asking Name ---
proposal: %name
    ^start(animations/Stand/Gestures/Joy_1)
    What's your name?
    $pepper-vinyl/tablet_dyn=name_from_keyboard

    # --- problem in capturing the concept of name ---
    u1: ({~myname} _* {~myname_after})
        $pepper-vinyl/username=$1
        ^gotoReactivate(confirm_name)

    u1: (e:pepper-vinyl/tablet_finish)
        $pepper-vinyl/username = $pepper-vinyl/answer
        ^gotoReactivate(check_name)



# --- Confirm Name ---
proposal: %confirm_name
    $pepper-vinyl/tablet_dyn=confirm_name
    ^start(animations/Stand/Gestures/Thinking_1)
    So you name is $pepper-vinyl/username , right?

    u1: ([
            ~acceptance
            "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
        ])
        ^gotoReactivate(check_name)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
        ])
        ^start(animations/Stand/Waiting/ScratchHead_1)
        Oh, I didn't understood correctly then. Could you repeat what you said?
        $pepper-vinyl/tablet_dyn=name_from_keyboard

            u2: ({~myname} _* {~myname_after})
                $pepper-vinyl/username=$1
                ^gotoReactivate(confirm_name)

            u2: (e:pepper-vinyl/tablet_finish)
                $pepper-vinyl/username = $pepper-vinyl/answer
                ^gotoReactivate(check_name)



# --- Checking Name ---
proposal: %check_name
    $pepper-vinyl/function=check_username

    u1: ("e:pepper-vinyl/long_time $pepper-vinyl/recognized==true $pepper-vinyl/long_time==false")
        $pepper-vinyl/tablet_dyn=welcome_old_user
        ^start(animations/Stand/Gestures/Salute_1)
        ~greetings $pepper-vinyl/username ! Welcome back to our shop!
        ^gotoReactivate(chit_chat)

    u1: ("e:pepper-vinyl/long_time $pepper-vinyl/recognized==true $pepper-vinyl/long_time==true")
        $pepper-vinyl/tablet_dyn=welcome_old_user_long_time
        ^start(animations/Stand/Gestures/Salute_1)
        ~greetings $pepper-vinyl/username ! I haven't seen you in a long time, welcome back to our shop!
        ^gotoReactivate(chit_chat)
    
    u1: ("e:pepper-vinyl/recognized $pepper-vinyl/recognized==false") 
        $pepper-vinyl/tablet_dyn=welcome_new_user
        ^start(animations/Stand/Gestures/Salute_1)
        ~greetings $pepper-vinyl/username ! Nice to meet you!
        ^gotoReactivate(chit_chat)



# --- Discuss about some news before starting ---
proposal: %chit_chat
    $pepper-vinyl/function=chit_chat

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==nothing") # -- the user has no interaction to be done, therefore go to menu
        ^gotoReactivate(menu)

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==orders_arrived") # -- the user has orders arrived, then show orders and enumerate them
        $pepper-vinyl/tablet_dyn=show_orders
        ^start(animations/Stand/Gestures/Explain_1)
        I have seen that we got some of your the orders: $pepper-vinyl/orders .
        You can get them from the cashier.
        ^gotoReactivate(need_something_else) # -- need something else

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==today_releases")
        ^gotoReactivate(today_releases)

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==author_releases")
        ^gotoReactivate(author_releases)

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==genre_releases")
        ^gotoReactivate(genre_releases)



# --- Discuss about today releases ---
proposal: %today_releases
    $pepper-vinyl/tablet_dyn=show_today_releases
    ^start(animations/Stand/Gestures/Explain_1)
    Are you here for one of today's new releases? $pepper-vinyl/today_releases

    u1: (~acceptance)
        Which one is of your interest?

        # --- answer from voice ---
        u2: (_*)
            $pepper-vinyl/request=$1
            ^gotoReactivate(check_today_request)

        # --- answer from tablet ---
        u2: (e:pepper-vinyl/answer)
            $pepper-vinyl/request=$pepper-vinyl/answer
            ^gotoReactivate(check_today_request)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==back"
        ])
        ^gotoReactivate(menu)

    # --- answer from voice ---
    u1: (_*)
        $pepper-vinyl/request=$1
        ^gotoReactivate(check_today_request)

    # --- answer from tablet ---
    u1: (e:pepper-vinyl/answer)
        $pepper-vinyl/request=$pepper-vinyl/answer
        ^gotoReactivate(check_today_request)



proposal: %check_today_request
    $pepper-vinyl/function=check_today_request

    u1: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
        ^gotoReactivate(get_the_vinyl)
    
    u1: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
        ^start(animations/Stand/Gestures/ScratchHead_1)
        I don't think that was the name of a vinyl.
        ^gotoReactivate(today_releases)



# --- Discuss about favourite author's new releases ---
proposal: %author_releases
    $pepper-vinyl/tablet_dyn=show_author_releases
    ^start(animations/Stand/Gestures/Explain_1)
    Good news! New vinyls from $pepper-vinyl/favourite_author just came out!
    We have $pepper-vinyl/author_releases , are you interested in any of them?

    u1: (~acceptance)
        ^start(animations/Stand/Gestures/YouKnowWhat_2)
        Which one is of your interest?

        # --- answer from voice ---
        u2: (_*)
            $pepper-vinyl/request=$1
            ^gotoReactivate(check_author_request)

        # --- answer from tablet ---
        u2: (e:pepper-vinyl/answer)
            $pepper-vinyl/request=$pepper-vinyl/answer
            ^gotoReactivate(check_author_request)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==back"
        ])
        ^gotoReactivate(menu)

    # --- answer from voice ---
    u1: (_*)
        $pepper-vinyl/request=$1
        ^gotoReactivate(check_author_request)

    # --- answer from tablet ---
    u1: (e:pepper-vinyl/answer)
        $pepper-vinyl/request=$pepper-vinyl/answer
        ^gotoReactivate(check_author_request)



proposal: %check_author_request
    $pepper-vinyl/function=check_author_request

    u1: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
        ^gotoReactivate(get_the_vinyl)
    
    u1: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
        ^start(animations/Stand/Gestures/ScratchHead_1)
        I don't think that was the name of a vinyl.
        ^gotoReactivate(author_releases)



# --- Discuss about favourite genre's new releases ---
proposal: %genre_releases
    $pepper-vinyl/tablet_dyn=show_genre_releases
    ^start(animations/Stand/Gestures/Explain_1)
    I see you like $pepper-vinyl/favourite_genre ! New vinyl of this genre just came out!
    We have $pepper-vinyl/genre_releases, are you interested in any of them?

    u1: (~acceptance)
        ^start(animations/Stand/Gestures/YouKnowWhat_2)
        Which one is of your interest?

        # --- answer from voice ---
        u2: (_*)
            $pepper-vinyl/request=$1
            ^gotoReactivate(check_genre_request)

        # --- answer from tablet ---
        u2: (e:pepper-vinyl/answer)
            $pepper-vinyl/request=$pepper-vinyl/answer
            ^gotoReactivate(check_genre_request)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==back"
        ])
        ^gotoReactivate(menu)

    # --- answer from voice ---
    u1: (_*)
        $pepper-vinyl/request=$1
        ^gotoReactivate(check_genre_request)

    # --- answer from tablet ---
    u1: (e:pepper-vinyl/answer)
        $pepper-vinyl/request=$pepper-vinyl/answer
        ^gotoReactivate(check_genre_request)



proposal: %check_genre_request
    $pepper-vinyl/function=check_genre_request

    u1: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
        ^gotoReactivate(get_the_vinyl)
    
    u1: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
        ^start(animations/Stand/Gestures/ScratchHead_1)
        I don't think that was the name of a vinyl.
        ^gotoReactivate(genre_releases)



# --- Main Menu ---
proposal: %menu
    $pepper-vinyl/tablet=ask_menu
    ^start(animations/Stand/Gestures/ShowTablet_1)
    Do you need something? I can provide you with suggestions, play demos or check for a specific vinyl you are interested in.

    u1: ([
            "{*} [suggestion suggestions] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==suggestion"
        ])
        ^gotoReactivate(suggestions)

    u1: ([
            "{*} [demo demos] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==demo"
        ])
        ^gotoReactivate(demo)

    u1: ([
            "{*} [specific certain] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==specific"
        ])
        ^gotoReactivate(specific)

    u1: ([
            "{*} [nothing no nope "i'm fine"] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==close"
        ])
        ^gotoReactivate(ask_review)


# --- Asking for specific Vinyl ---
proposal: %specific
    $pepper-vinyl/tablet=execute_show-vinyls-empty
    ^start(animations/Stand/Gestures/ShowTablet_1)
    Here is the catalogue of the vinyls available, you can also directly tell me the name of what you are looking for.
    $pepper-vinyl/tablet_dyn=show_vinyls

    u1: (_*)
        $pepper-vinyl/vinyl_name=$1
        ^gotoReactivate(check_storage)

    u1: (e:pepper-vinyl/tablet_finish)
        $pepper-vinyl/vinyl_name = $pepper-vinyl/answer
        ^gotoReactivate(check_storage)



# --- Provide Suggestions ---
proposal: %suggestions
    $pepper-vinyl/tablet=ask_type-of-suggestion
    ^start(animations/Stand/Gestures/Explain_3)
    I can provide you suggestions based on recent trends, on your favourite genre or author or I can think of something you may like based on previous interactions we had.

    u1: ([
            "{*} genre {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==genre"
        ])
        $pepper-vinyl/function=check_favourite_genre

        u2: (e:pepper-vinyl/has_favourite_genre $pepper-vinyl/has_favourite_genre==true)
            ^gotoReactivate(give_suggestion_genre)
        
        u2: (e:pepper-vinyl/has_favourite_genre $pepper-vinyl/has_favourite_genre==false)
            $pepper-vinyl/tablet=execute_i-dont-know-your-favourite
            ^start(animations/Stand/Gestures/You_1)
            Ok, but before doing that I need to know which genre you like!
            ^gotoReactivate(ask_favourite_genre)

    u1: ([
            "{*} author {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==author"          
        ])
        $pepper-vinyl/function=check_favourite_author

        u2: (e:pepper-vinyl/has_favourite_author $pepper-vinyl/has_favourite_author==true)
            ^gotoReactivate(give_suggestion_author)
        
        u2: (e:pepper-vinyl/has_favourite_author $pepper-vinyl/has_favourite_author==false)
            $pepper-vinyl/tablet=execute_i-dont-know-your-favourite
            ^start(animations/Stand/Gestures/You_1)
            Ok, but before dding that I need to know which author you like!
            ^gotoReactivate(ask_favourite_author)

    u1: ([
            "{*} [interaction interactions] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==interactions"
        ])
        $pepper-vinyl/function=check_interactions

        u2: (e:pepper-vinyl/has_interactions $pepper-vinyl/has_interactions==true)
            ^gotoReactivate(recommendation)

        u2: (e:pepper-vinyl/has_interactions $pepper-vinyl/has_interactions==false)
            $pepper-vinyl/tablet=execute_i-dont-have-previous-interactions
            ^start(animations/Stand/Emotions/Negative/Sorry_1)
            I'm sorry but i don't know of any your previous interactions.
            # could ask questions to add to the database!
            ^gotoReactivate(need_something_else)

    u1: ([
            "{*} [trend trends trending] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==trends"
        ])
        $pepper-vinyl/function=check_trends

        u2: (e:pepper-vinyl/has_trends $pepper-vinyl/has_trends==true)
            ^gotoReactivate(give_suggestion_trends)

        u2: (e:pepper-vinyl/has_trends $pepper-vinyl/has_trends==false)
            $pepper-vinyl/tablet=execute_no-trends
            ^start(animations/Stand/Emotions/Negative/Sorry_1)
            I'm sorry, it seems there are no particular trends recently.
            ^gotoReactivate(need_something_else)



# --- Check in the Storage ---
proposal: %check_storage
    ^start(animations/Stand/Waiting/Thinking_1)
    $pepper-vinyl/function="check_storage"
    
    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==available)
        $pepper-vinyl/tablet=execute_vinyl-found
        ^start(animations/Stand/Gestures/Yes_1)
        The vinyl you were looking for is available right now!
        ^gotoReactivate(get_the_vinyl)
    
    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==out_of_stock)
        $pepper-vinyl/tablet_dyn=order_vinyl
        ^start(animations/Stand/Gestures/IDontKnow_6)
        I'm sorry! We don't have it in storage right now but i can order it for you.
        Do you want me to procede?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            ^start(animations/Stand/Gestures/Yes_1)
            Ok, i will add it to the list of orders.
            $pepper-vinyl/function="order_vinyl"
            ^gotoReactivate(need_something_else)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            ^gotoReactivate(need_something_else)

    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==unknown)
        $pepper-vinyl/tablet=execute_vinyl-not-found
        ^start(animations/Stand/Gestures/No_1)
        I'm sorry, i don't know any vinyl with that name.
        ^gotoReactivate(need_something_else)



# --- Point to the Vinyl and Guide the User ---
proposal: %get_the_vinyl
    $pepper-vinyl/function="point_to_vinyl"

    u1: (e:pepper-vinyl/finish_wait)
        $pepper-vinyl/tablet=ask_get-the-vinyl
        The vinyls is right there.
        I can guide you to it or take it for you. Otherwise if you prefer you can go by yourself.
        $pepper-vinyl/function=rotate_back

        u2: ([
                "{*} guide {*}"
                "e:pepper-vinyl/answer $pepper-vinyl/answer==guide_me"
            ])
            $pepper-vinyl/tablet=execute_follow-me
            ^start(animations/Stand/Gestures/Explain_1)
            Ok, follow me then.
            $pepper-vinyl/function=guide_client

            u3: ("e:pepper-vinyl/finish_wait $pepper-vinyl/vinyl_present==true")
                $pepper-vinyl/tablet=execute_here-it-is
                ^start(animations/Stand/Gestures/ShowFloor_1)
                Your vinyl is right here.
                ^gotoReactivate(need_something_else)

            u3: ("e:pepper-vinyl/finish_wait $pepper-vinyl/vinyl_present==false")
                $pepper-vinyl/tablet=ask_not-found
                ^start(animations/Stand/Gestures/IDontKnow_6)
                Your vinyl should be there, but it seems it was moved somewhere else.
                You could ask to a member of the staff about it. 
                Otherwise i can order it for you. Do you want me to procede?

                u4: ([
                        ~acceptance
                        "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                    ])
                    ^start(animations/Stand/Gestures/Yes_1)
                    Ok, i will add it to the list of orders.
                    $pepper-vinyl/function="order_vinyl"
                    ^gotoReactivate(need_something_else)

                u4: ([
                        ~refusal
                        "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                    ])
                    ^gotoReactivate(need_something_else)


        u2: ([
                "{*} take {*}"
                "e:pepper-vinyl/answer $pepper-vinyl/answer==take_it"
            ])
            $pepper-vinyl/tablet=execute_wait-here
            ^start(animations/Stand/Gestures/Explain_1)
            Ok, I'll take it and bring it back to you.
            $pepper-vinyl/function="take_and_go_back"

            u3: ("e:pepper-vinyl/finish_wait $pepper-vinyl/vinyl_present==true")
                $pepper-vinyl/tablet=execute_here-it-is
                Here is your vinyl.
                ^gotoReactivate(need_something_else)

            u3: ("e:pepper-vinyl/finish_wait $pepper-vinyl/vinyl_present==false")
                $pepper-vinyl/tablet=ask_not-found
                ^start(animations/Stand/Gestures/IDontKnow_6)
                Your vinyl should be there, but it seems it was moved somewhere else.
                You could ask to a member of the staff about it. 
                Otherwise i can order it for you. Do you want me to procede?

                u4: ([
                        ~acceptance
                        "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                    ])
                    ^start(animations/Stand/Gestures/Yes_1)
                    Ok, i will add it to the list of orders.
                    $pepper-vinyl/function="order_vinyl"
                    ^gotoReactivate(need_something_else)

                u4: ([
                        ~refusal
                        "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                    ])
                    ^gotoReactivate(need_something_else)

        u2: ([
                "{*} myself {*}"
                "e:pepper-vinyl/answer $pepper-vinyl/answer==by_myself"
            ])
            ^gotoReactivate(need_something_else)

        u2: ([
                "{*} forget {*}"
                "e:pepper-vinyl/answer $pepper-vinyl/answer==forget_it"

            ])
            ^gotoReactivate(check_counter)



# --- Offer Suggestions to Undecided Users ---
proposal: %check_counter
    $pepper-vinyl/function=check_counter

    u1: ("e:pepper-vinyl/undecided $pepper-vinyl/undecided=true")
        $pepper-vinyl/tablet=ask_undecided
        ^start(animations/Stand/Gestures/Explain_3)
        You seem undecided! Would you like some suggestions to help you decide?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            ^gotoReactivate(suggestions)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            ^gotoReactivate(need_something_else)

    u1: ("e:pepper-vinyl/undecided $pepper-vinyl/undecided=false")
        ^gotoReactivate(need_something_else)



# --- Ask the Favourite Genre of the User ---
proposal: %ask_favourite_genre
    ^start(animations/Stand/Gestures/You_1)
    What is you favourite genre? 

    u1: (~dont_know)
        $pepper-vinyl/favourite_genre="anything"
        $pepper-vinyl/function="set_favourite_genre"
        ^gotoReactivate(give_suggestion)

    u1: (_*)
        $pepper-vinyl/favourite_genre=$1
        $pepper-vinyl/function="set_favourite_genre"

        u2: (e:pepper-vinyl/genre_recognized $pepper-vinyl/genre_recognized==true)
            ^gotoReactivate(give_suggestion)

        u2: (e:pepper-vinyl/genre_recognized $pepper-vinyl/genre_recognized==false)
            ^start(animations/Stand/Gestures/IDontKnow_1)
            That doesn't look like a music genre, could you try something else?
            ^gotoReactivate(ask_favourite_genre)



# --- Ask the Favourite Author of the User ---
proposal: %ask_favourite_author
    ^start(animations/Stand/Gestures/You_1)
    What is you favourite author? 

    u1: (~dont_know)
        $pepper-vinyl/favourite_author="anything"
        $pepper-vinyl/function="set_favourite_author"
        ^gotoReactivate(give_suggestion)

    u1: (_*)
        $pepper-vinyl/favourite_author=$1
        $pepper-vinyl/function="set_favourite_author"

        u2: (e:pepper-vinyl/author_recognized $pepper-vinyl/author_recognized==true)
            ^gotoReactivate(give_suggestion)

        u2: (e:pepper-vinyl/author_recognized $pepper-vinyl/author_recognized==false)
            ^start(animations/Stand/Gestures/IDontKnow_1)
            That doesn't look like a music author, could you try something else?
            ^gotoReactivate(ask_favourite_author)



# --- Provide Suggestion based on Recent Trends ---
proposal: %give_suggestion_trends
    $pepper-vinyl/function=find_suggestion_trends

    u1: (e:pepper-vinyl/suggestion)
        $pepper-vinyl/tablet_dyn=show_suggestion_trends
        ^start(animations/Stand/Gestures/ShowTablet_1)
        The most trending vinyl this month is "$pepper-vinyl/suggestion" .
        Do you want to listen to a demo of it?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
            ^gotoReactivate(play_vinyl)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            $pepper-vinyl/tablet=ask_do-you-want-to-buy
            ^start(animations/Stand/Gestures/You_1)
            Do you want to buy it?

            u3: ([
                    ~acceptance
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                ])
                $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
                ^gotoReactivate(get_the_vinyl)

            u3: ([
                    ~refusal
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                ])
                ^gotoReactivate(need_something_else)



# --- Provide Suggestion based on Favourite Genre ---
proposal: %give_suggestion_genre
    $pepper-vinyl/function="find_suggestion_genre"

    u1: (e:pepper-vinyl/suggestion)
        $pepper-vinyl/tablet_dyn=show_suggestion_genre
        ^start(animations/Stand/Gestures/ShowTablet_1)
        Here is the newest vinyl from $pepper-vinyl/selected_genre: "$pepper-vinyl/suggestion" .
        Do you want to listen to a demo of it?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
            ^gotoReactivate(play_vinyl)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            $pepper-vinyl/tablet=ask_do-you-want-to-buy
            ^start(animations/Stand/Gestures/You_1)
            Do you want to buy it?

            u3: ([
                    ~acceptance
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                ])
                $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
                ^gotoReactivate(get_the_vinyl)

            u3: ([
                    ~refusal
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                ])
                ^gotoReactivate(need_something_else)



# --- Provide Suggestion based on Favourite Author ---
proposal: %give_suggestion_author
    $pepper-vinyl/function="find_suggestion_author"

    u1: (e:pepper-vinyl/suggestion)
        $pepper-vinyl/tablet_dyn=show_suggestion_author
        ^start(animations/Stand/Gestures/ShowTablet_1)
        Here is the newest vinyl from $pepper-vinyl/selected_author:  "$pepper-vinyl/suggestion" .
        Do you want to listen to a demo of it?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
            ^gotoReactivate(play_vinyl)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            $pepper-vinyl/tablet=ask_do-you-want-to-buy
            ^start(animations/Stand/Gestures/You_1)
            Do you want to buy it?

            u3: ([
                    ~acceptance
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                ])
                $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
                ^gotoReactivate(get_the_vinyl)

            u3: ([
                    ~refusal
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                ])
                ^gotoReactivate(need_something_else)



proposal: %demo
    $pepper-vinyl/tablet=execute_show-vinyls-empty
    ^start(animations/Stand/Gestures/ShowTablet_1)
    Here is the catalogue of the vinyls available, you can also directly tell me the name of what you are looking for.
    $pepper-vinyl/tablet_dyn=show_vinyls

    u1: (_*)
        $pepper-vinyl/vinyl_name=$1
        ^gotoReactivate(play_vinyl)

    u1: (e:pepper-vinyl/tablet_finish)
        $pepper-vinyl/vinyl_name = $pepper-vinyl/answer
        ^gotoReactivate(play_vinyl)



proposal: %play_vinyl
    $pepper-vinyl/tablet_dyn=playing_music
    Ok! I'll start playing a demo from $pepper-vinyl/vinyl_name
    $pepper-vinyl/function=play_demo

        u1: (e:pepper-vinyl/finish_wait $pepper-vinyl/reaction==happy)
            $pepper-vinyl/tablet=ask_do-you-want-to-buy-liked
            ^start(animations/Stand/Gestures/Enthusiastic_2)
            I see that you really liked the demo. Are you interested in buying the vinyl?

            u2: ([
                    ~acceptance
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                ])
                ^gotoReactivate(check_storage)

            u2: ([
                    ~refusal
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                ])
                ^gotoReactivate(need_something_else)                

        u1: (e:pepper-vinyl/finish_wait $pepper-vinyl/reaction==neutral)
            $pepper-vinyl/tablet=ask_do-you-want-to-buy-neutral
            ^start(animations/Stand/Gestures/IDontKnow_6)
            I see you have mixed emotions about this demo. Despite that, are you interested in buying the vinyl?

            u2: ([
                    ~acceptance
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                ])
                ^gotoReactivate(check_storage)

            u2: ([
                    ~refusal
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                ])
                ^gotoReactivate(need_something_else)


        u1: (e:pepper-vinyl/finish_wait $pepper-vinyl/reaction==disgusted)
            $pepper-vinyl/tablet=ask_play-something-else
            ^start(animations/Stand/Gestures/No_2)
            Oh, I see that you didn't like it very much... I won't play it again.
            Do you want me to suggest something different instead?

            u2: ([
                    ~acceptance
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                ])
                ^gotoReactivate(different_demo)

            u2: ([
                    ~refusal
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                ])
                ^gotoReactivate(need_something_else)


proposal: %different_demo
    $pepper-vinyl/tablet=execute_computing-recommendations
    ^start(animations/Stand/Waiting/Think_2)
