        ^gotoReactivate(menu)

    # --- answer from voice ---
    u1: (_*)
        $pepper-vinyl/request=$1
        $pepper-vinyl/function=check_genre_request

        u2: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
            ^gotoReactivate(get_the_vinyl)
        
        u2: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
            I don't think that was the name of a vinyl.
            ^gotoReactivate(genre_releases)

    # --- answer from tablet ---
    u1: (e:pepper-vinyl/answer)
        $pepper-vinyl/request=$pepper-vinyl/answer
        $pepper-vinyl/function=check_genre_request

        u2: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
            ^gotoReactivate(get_the_vinyl)
        
        u2: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
            I don't think that was the name of a vinyl.
            ^gotoReactivate(genre_releases)



# --- Main Menu ---
proposal: %menu
    $pepper-vinyl/tablet=ask_menu
    $pepper-vinyl/function=idle_animation_1
    Do you need something? I can provide you with suggestions, play demos or check for a specific vinyl you are interested in.

    u1: ([
            "{*} [suggestion suggestions] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==suggestion"
        ])
        ^gotoReactivate(suggestions)

    u1: ([
            "{*} [demo demos] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==demo"
        ])
        ^gotoReactivate(demo)

    u1: ([
            "{*} [specific certain] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==specific"
        ])
        ^gotoReactivate(specific)

    u1: ([
            "{*} [nothing no nope "i'm fine"] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==close"
        ])
        $pepper-vinyl/tablet=execute_goodbye
        $pepper-vinyl/function=bow
        Thank you for choosing our store, you can find the cashier near the entrance.
        If you need something else you can ask me again.
        $pepper-vinyl/function=reset

        u2: (e:pepper-vinyl/finish_wait)
            ^gotoReactivate(restart)


# --- Asking for specific Vinyl ---
proposal: %specific
    $pepper-vinyl/tablet=execute_show-vinyls-empty
    $pepper-vinyl/function=idle_animation_2
    Here is the catalogue of the vinyls available, you can also directly tell me the name of what you are looking for.
    $pepper-vinyl/tablet_dyn=show_vinyls

    u1: (_*)
        $pepper-vinyl/vinyl_name=$1
        ^gotoReactivate(check_storage)

    u1: (e:pepper-vinyl/tablet_finish)
        $pepper-vinyl/vinyl_name = $pepper-vinyl/answer
        ^gotoReactivate(check_storage)



# --- Provide Suggestions ---
proposal: %suggestions
    $pepper-vinyl/tablet=ask_type-of-suggestion
    $pepper-vinyl/function=idle_animation_3
    I can provide you suggestions based on your favourite genre or author or I can think of something you may like based on previous interactions we had.

    u1: ([
            "{*} genre {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==genre"
        ])
        $pepper-vinyl/function=check_favourite_genre

        u2: (e:pepper-vinyl/has_favourite_genre $pepper-vinyl/has_favourite_genre==true)
            ^gotoReactivate(give_suggestion_genre)
        
        u2: (e:pepper-vinyl/has_favourite_genre $pepper-vinyl/has_favourite_genre==false)
            $pepper-vinyl/tablet=execute_i-dont-know-your-favourite
            Ok, but before dding that I need to know which genre you like!
            ^gotoReactivate(ask_favourite_genre)

    u1: ([
            "{*} author {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==author"          
        ])
        $pepper-vinyl/function=check_favourite_author

        u2: (e:pepper-vinyl/has_favourite_author $pepper-vinyl/has_favourite_author==true)
            ^gotoReactivate(give_suggestion_author)
        
        u2: (e:pepper-vinyl/has_favourite_author $pepper-vinyl/has_favourite_author==false)
            $pepper-vinyl/tablet=execute_i-dont-know-your-favourite
            Ok, but before dding that I need to know which author you like!
            ^gotoReactivate(ask_favourite_author)

    u1: ([
            "{*} [interaction interactions] {*}"
            "e:pepper-vinyl/answer $pepper-vinyl/answer==interactions"
        ])
        $pepper-vinyl/function=check_interactions

        u2: (e:pepper-vinyl/has_interactions $pepper-vinyl/has_interactions==true)
            ^gotoReactivate(recommendation)

        u2: (e:pepper-vinyl/has_interactions $pepper-vinyl/has_interactions==false)
            $pepper-vinyl/tablet=execute_i-dont-have-previous-interactions
            I'm sorry but i don't know of any your previous interactions.
            # could ask questions to add to the database!
            ^gotoReactivate(need_something_else)



# --- Check in the Storage ---
proposal: %check_storage
    $pepper-vinyl/function="check_storage"
    
    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==available)
        $pepper-vinyl/tablet=execute_vinyl-found
        The vinyl you were looking for is available right now!
        ^gotoReactivate(get_the_vinyl)
    
    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==out_of_stock)
        $pepper-vinyl/tablet_dyn=order_vinyl
        $pepper-vinyl/function=idle_animation_1
        I'm sorry! We don't have it in storage right now but i can order it for you.
        Do you want me to procede?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            Ok, i will add it to the list of orders.
            $pepper-vinyl/function="order_vinyl"
            ^gotoReactivate(need_something_else)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            ^gotoReactivate(need_something_else)

    u1: (e:pepper-vinyl/vinyl_found $pepper-vinyl/vinyl_found==unknown)
        $pepper-vinyl/tablet=execute_vinyl-not-found
        I'm sorry, i don't know any vinyl with that name.
        ^gotoReactivate(need_something_else)



# --- Point to the Vinyl and Guide the User ---
proposal: %get_the_vinyl
    $pepper-vinyl/function="point_to_vinyl"

    u1: (e:pepper-vinyl/finish_wait)
        $pepper-vinyl/tablet=ask_get-the-vinyl
        The vinyls is right there.
        I can guide you to it or take it for you. Otherwise if you prefer you can go by yourself.
        $pepper-vinyl/function=reset_posture

        u2: ([
                "{*} guide {*}"
                "e:pepper-vinyl/answer $pepper-vinyl/answer==guide_me"
            ])
            $pepper-vinyl/tablet=execute_follow-me
            Ok, follow me then.
            $pepper-vinyl/function=guide_client

            u3: (e:pepper-vinyl/finish_wait)
                $pepper-vinyl/tablet=execute_here-it-is
                Your vinyl is right here.
                ^gotoReactivate(need_something_else)

        u2: ([
                "{*} take {*}"
                "e:pepper-vinyl/answer $pepper-vinyl/answer==take_it"
            ])
            $pepper-vinyl/tablet=execute_wait-here
            Ok, I'll take it and bring it back to you.
            $pepper-vinyl/function="take_and_go_back"

            u3: (e:pepper-vinyl/finish_wait)
                $pepper-vinyl/tablet=execute_here-it-is
                Here is your vinyl.
                ^gotoReactivate(need_something_else)

        u2: ([
                "{*} myself {*}"
                "{*} forget {*}"
                "e:pepper-vinyl/answer $pepper-vinyl/answer==forget_it"
                "e:pepper-vinyl/answer $pepper-vinyl/answer==by_myself"
            ])
            ^gotoReactivate(need_something_else)



# --- Ask the Favourite Genre of the User ---
proposal: %ask_favourite_genre
    What is you favourite genre? 

    u1: (~dont_know)
        $pepper-vinyl/favourite_genre="anything"
        $pepper-vinyl/function="set_favourite_genre"
        ^gotoReactivate(give_suggestion)

    u1: (_*)
        $pepper-vinyl/favourite_genre=$1
        $pepper-vinyl/function="set_favourite_genre"

        u2: (e:pepper-vinyl/genre_recognized $pepper-vinyl/genre_recognized==true)
            ^gotoReactivate(give_suggestion)

        u2: (e:pepper-vinyl/genre_recognized $pepper-vinyl/genre_recognized==false)
            That doesn't look like a music genre, could you try something else?
            ^gotoReactivate(ask_favourite_genre)



# --- Ask the Favourite Author of the User ---
proposal: %ask_favourite_author
    What is you favourite author? 

    u1: (~dont_know)
        $pepper-vinyl/favourite_author="anything"
        $pepper-vinyl/function="set_favourite_author"
        ^gotoReactivate(give_suggestion)

    u1: (_*)
        $pepper-vinyl/favourite_author=$1
        $pepper-vinyl/function="set_favourite_author"

        u2: (e:pepper-vinyl/author_recognized $pepper-vinyl/author_recognized==true)
            ^gotoReactivate(give_suggestion)

        u2: (e:pepper-vinyl/author_recognized $pepper-vinyl/author_recognized==false)
            That doesn't look like a music author, could you try something else?
            ^gotoReactivate(ask_favourite_author)



# --- Provide Suggestion based on Favourite Genre ---
proposal: %give_suggestion_genre
    $pepper-vinyl/function="find_suggestion_genre"

    u1: (e:pepper-vinyl/suggestion)
        $pepper-vinyl/tablet_dyn=show_suggestion_genre
        Here is the newest vinyl from $pepper-vinyl/selected_genre:  "$pepper-vinyl/suggestion" .
        Do you want to listen to a demo of it?

        u2: ([
                ~acceptance
                "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
            ])
            $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
            ^gotoReactivate(play_vinyl)

        u2: ([
                ~refusal
                "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
            ])
            $pepper-vinyl/tablet=ask_do-you-want-to-buy
            Do you want to buy it?

            u3: ([
                    ~acceptance
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
                ])
                $pepper-vinyl/vinyl_name=$pepper-vinyl/suggestion
                ^gotoReactivate(get_the_vinyl)

            u3: ([
                    ~refusal
                    "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
                ])
                ^gotoReactivate(need_something_else)



# --- Provide Suggestion based on Favourite Author ---
