            $pepper-vinyl/request=$pepper-vinyl/answer
            ^gotoReactivate(check_recommendation_request)



proposal: %check_recommendation_request
    $pepper-vinyl/function=check_recommendation_request

    u1: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
        ^gotoReactivate(check_storage)
    
    u1: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
        ^start(animations/Stand/Gestures/ScratchHead_1)
        I don't think that was the name of a vinyl.
        ^gotoReactivate(retry_recommendation)



proposal: %need_something_else
    $pepper-vinyl/tablet=ask_need-something-else
    ^start(animations/Stand/Gestures/You_1)
    Do you need help with something else?

    u1: ([
            ~acceptance
            "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
        ])
        ^gotoReactivate(menu)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
        ])
        ^gotoReactivate(ask_review)



proposal: %ask_review
    $pepper-vinyl/tablet=ask_leave-a-review
    ^start(animations/Stand/Gestures/Explain_3)
    Before leaving, would you like to leave a review of the service?

    u1: ([
            ~acceptance
            "e:pepper-vinyl/answer $pepper-vinyl/answer==yes"
        ])
        $pepper-vinyl/tablet=ask_review
        ^start(animations/Stand/Gestures/ScratchHead_1)
        How would you rate the service between 1 and 5?

        u2: ("{*} ~rating {*}")
            $pepper-vinyl/rating=$1
            ^gotoReactivate(save_rating)

        u2: (e:pepper-vinyl/answer)
            $pepper-vinyl/rating=$pepper-vinyl/answer
            ^gotoReactivate(save_rating)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==no"
        ])
        ^gotoReactivate(finish)



proposal: %save_rating
    $pepper-vinyl/function=save_rating
    ^start(animations/Stand/Emotions/Positive/Happy_1)
    Your vote has been submitten!
    # REACT TO THE RATING RECEIVED?
    ^gotoReactivate(finish)



proposal: %finish
    $pepper-vinyl/tablet=execute_goodbye
    ^start(animations/Stand/Gestures/BowShort_1)
    Thank you for choosing our store, you can find the cashier near the entrance.
    If you need something else you can ask me again.
    $pepper-vinyl/function=reset

    u1: (e:pepper-vinyl/finish_wait)
        ^gotoReactivate(restart)