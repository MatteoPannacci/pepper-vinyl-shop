topic: ~assistant()
language: enu

# --- Concepts ---

concept: (myname) ["My name is" "I'm" "I am"
                   "This is" "They call me" "You can call me" 
                   "I go by" "The name's" "It's me"]

concept: (myname_after) ["is my name"]

concept: (greetings) ^rand["hi" "hello" "hello there" "hey there" "good morning"
                           "hey" "hi there" "good afternoon" "good evening"
                           "greetings" "good day"]

concept: (goodbye) ["goodbye"]

concept: (acceptance) ["yes" "ok" "fine"]

concept: (refusal) ["no" "nope"]

concept: (dont_know) ["I don't know" "don't know"]

concept: (rating) ["1" "2" "3" "4" "5"]



# --- Global Greeting ---
u: ([
        ~greetings
        "e:pepper-vinyl/answer $pepper-vinyl/answer==start_button"
    ])
    ^gotoReactivate(begin)



# --- Restart ---tablet/actions/ask-name
proposal: %restart
    $pepper-vinyl/tablet=ask_welcome

    u1: ([
            ~greetings
            "e:pepper-vinyl/answer $pepper-vinyl/answer==start_button"
        ]) 
        ^gotoReactivate(begin)



# --- Begin ---
proposal: %begin
    $pepper-vinyl/function=greeting_animation
    $pepper-vinyl/tablet=execute_hello
    Hello! I'm Pepper, your shopping assistant for this Vinyl Shop.
    I'm here to inform and help you.
    ^gotoReactivate(name)



# --- Global Goodbye ---
u: (~goodbye) 
    Goodbye! I'm going to wait for the next client.
    ^gotoReactivate(restart)



# --- Asking Name ---
proposal: %name
    What's your name?
    $pepper-vinyl/tablet_dyn=name_from_keyboard

    # --- problem in capturing the concept of name ---
    u1: ({~myname} _* {~myname_after})
        $pepper-vinyl/username=$1
        ^gotoReactivate(check_name)

    u1: (e:pepper-vinyl/tablet_finish)
        $pepper-vinyl/username = $pepper-vinyl/answer
        ^gotoReactivate(check_name)


# --- Checking Name ---
proposal: %check_name
    $pepper-vinyl/function=idle_animation_1
    $pepper-vinyl/function=check_username

    u1: ("e:pepper-vinyl/recognized $pepper-vinyl/recognized==true")
        $pepper-vinyl/tablet_dyn=welcome_old_user
        ~greetings $pepper-vinyl/username ! Welcome back to our shop!
        ^gotoReactivate(chit_chat)
    
    u1: ("e:pepper-vinyl/recognized $pepper-vinyl/recognized==false") 
        $pepper-vinyl/tablet_dyn=welcome_new_user
        ~greetings $pepper-vinyl/username ! Nice to meet you!
        ^gotoReactivate(chit_chat)



proposal: %chit_chat
    $pepper-vinyl/function=chit_chat

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==nothing") # -- the user has no interaction to be done, therefore go to menu
        ^gotoReactivate(menu)

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==orders_arrived") # -- the user has orders arrived, then show orders and enumerate them
        $pepper-vinyl/function=idle_animation_3
        $pepper-vinyl/tablet_dyn=show_orders
        I have seen that we got some of your the orders: $pepper-vinyl/orders .
        You can get them from the cashier.
        ^gotoReactivate(need_something_else) # -- need something else

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==today_releases")
        ^gotoReactivate(today_releases)

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==author_releases")
        ^gotoReactivate(author_releases)

    u1: ("e:pepper-vinyl/chit_chat $pepper-vinyl/chit_chat==genre_releases")
        ^gotoReactivate(genre_releases)



proposal: %today_releases
    $pepper-vinyl/tablet_dyn=show_today_releases
    Are you here for one of today's new releases? $pepper-vinyl/today_releases

    u1: (~acceptance)
        Which one is of your interest?

        # --- answer from voice ---
        u2: (_*)
            $pepper-vinyl/request=$1
            $pepper-vinyl/function=check_today_request

            u3: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
                ^gotoReactivate(get_the_vinyl)
            
            u3: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
                I don't think that was the name of a vinyl.
                ^gotoReactivate(today_releases)

        # --- answer from tablet ---
        u2: (e:pepper-vinyl/answer)
            $pepper-vinyl/request=$pepper-vinyl/answer
            $pepper-vinyl/function=check_today_request

            u3: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
                ^gotoReactivate(get_the_vinyl)
            
            u3: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
                I don't think that was the name of a vinyl.
                ^gotoReactivate(today_releases)

    u1: ([
            ~refusal
            "e:pepper-vinyl/answer $pepper-vinyl/answer==back"
        ])
        ^gotoReactivate(menu)

    # --- answer from voice ---
    u1: (_*)
        $pepper-vinyl/request=$1
        $pepper-vinyl/function=check_today_request

        u2: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
            ^gotoReactivate(get_the_vinyl)
        
        u2: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
            I don't think that was the name of a vinyl.
            ^gotoReactivate(today_releases)

    # --- answer from tablet ---
    u1: (e:pepper-vinyl/answer)
        $pepper-vinyl/request=$pepper-vinyl/answer
        $pepper-vinyl/function=check_today_request

        u2: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==true)
            ^gotoReactivate(get_the_vinyl)
        
        u2: (e:pepper-vinyl/vinyl_recognized $pepper-vinyl/vinyl_recognized==false)
            I don't think that was the name of a vinyl.
            ^gotoReactivate(today_releases)



